---
/**
 * Who wrote this, and whether a person re-read it (D0.27, D16.79, AI Act art. 50 § 4).
 *
 * Our texts are prepared with an AI tool; their supports and their figures are checked against
 * the book by gates (scripts/editorial.test.ts). Whether a person re-read them is a fact of the
 * file, and the page says exactly that fact: « accepted » — published on the editor's word,
 * not re-read line by line — says an AI prepared it and names no reader; only « reviewed »
 * names one. The site does not lean on the exception of art. 50 § 4 for a review that did
 * not take place: it says the AI (as the sentences do since D16.56). A pending entry is not
 * published on the public site (scripts/launch.ts).
 *
 * A page that cites studies says one thing more: their figures are checked against their own
 * documents, linked under each — not against the book (D21.1).
 */
import type { Review } from '../lib/editorial.ts';
import { t } from '../lib/strings.ts';

interface Props {
  review: Review;
  /** The page cites studies (D21.1). */
  studies?: boolean;
}
const { review, studies = false } = Astro.props;
const status =
  review.status === 'reviewed'
    ? t('concept.authorship.reviewed')
    : review.status === 'accepted'
      ? t('concept.authorship.accepted')
      : t('concept.authorship.pending');
// Two sentences, each ended: the line of a re-read text has no full stop of its own, and the
// sentence on the studies would run into it (review of 24/11/2026, K23).
const line =
  studies && review.status !== 'pending'
    ? `${/[.!?…]$/.test(status) ? status : `${status}.`} ${t('concept.authorship.studies')}`
    : status;
---

<p class="ref authorship" data-review={review.status}>{line}</p>
