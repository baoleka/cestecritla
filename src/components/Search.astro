---
/**
 * The search island: one field, and results while one types (D16.9).
 *
 * Contract with the page around it:
 *   - without JavaScript it does not exist: the form is `hidden` until the script shows it, and
 *     the table of contents is the navigation — below the field on /sommaire/, one link away
 *     everywhere else;
 *   - the words typed never leave the device. The index (stems, no sentence) and the list of
 *     titles are two static files fetched once; the query runs here. The address bar keeps the
 *     query after `#`, the one part of a URL a browser does not send to a server;
 *   - a result never prints a measure. It names the section, numbers the measures that match,
 *     and each number is a link into the official page (D15.2);
 *   - there is no button: results follow the typing, and Enter — the « Rechercher » key of a
 *     phone keyboard — moves the focus to them. The sentence that counts them is a
 *     `role="status"`, written once the typing has paused, never at every key.
 *
 * The strings the script needs are handed to it as JSON, so that they come from the kit like
 * every other sentence of the interface.
 *
 * « Demander » (D16.45 to D16.51). When data/2026/ask.json says the site answers questions, and
 * the page asks for it (`ask`), the same field gains ONE button — it opens the sheet of
 * src/components/ChatSheet.astro, and what was typed becomes the first question — and the
 * notice, before the first use, of what asking does and of the AI that may explain. In mode
 * "off" none of it is rendered: no button, no notice, no sheet, no script, and the page says
 * the search is local, which is then the whole truth.
 */
import { askSite } from '../lib/ask-config.ts';
import { manifest } from '../lib/edition.ts';
import { cards } from '../lib/editorial.ts';
import { locatorDisplay } from '../lib/facts.ts';
import { builtWords, wordsNames } from '../lib/words-data.ts';
import { safeJson, t } from '../lib/strings.ts';

interface Props {
  /** The page already shows the table of contents: the sentence left without script is no link. */
  toc?: boolean | undefined;
  /** The field of this page may also ask (the home page). Only when the mode allows it. */
  ask?: boolean | undefined;
}
const { toc = false, ask = false } = Astro.props;

const version = manifest().meta.corpus_version;
const site = askSite();
const asking = ask && site.mode === 'chat';
/** The model that explains — null since D16.60: the sheet opens without a live AI. */
const model = site.modelName;
// Imported only by a build whose field asks (astro.config.ts): a condition the bundler can
// fold removes the import itself — and with it the sheet's stylesheet and its script.
const ChatSheet = __CEL_CHAT__ ? (await import('./ChatSheet.astro')).default : null;
// Where the search says that what is typed is an explained word (PLAN-MOTS, lot 6): how the
// words are found — one file, fetched with the index —, our cards by their terms, and the line.
// Folded away by a build that does not show it: its page is then the page of before.
const wordsFinder = __CEL_WORDS_SEARCH__
  ? `/data/${wordsNames(builtWords().fingerprint).finder}.json`
  : null;
const strings = {
  opening: t('search.opening'),
  one: t('search.results_count_one'),
  many: t('search.results_count', { count: '{count}' }),
  none: t('search.no_results'),
  noneHint: t('search.no_results_hint'),
  where: t('search.result.where'),
  incipit: t('quote.incipit_label'),
  firstWords: t('quote.first_words_label'),
  missing: `${t('error.data.title')} ${t('error.data.lead')}`,
  ...(__CEL_WORDS_SEARCH__
    ? {
        wordRow: t('words.search.row', { term: '{term}' }),
        cards: cards().map(({ id, term }) => ({ id, term })),
      }
    : {}),
};
---

{
  /* In the page from the first paint. Revealed by its script, the field pushed everything
     under it down a second after the page could be read (0.17 of layout shift, measured on
     13/11/2026: scripts/perf-probe.ts). Where scripts are off it would be a field that answers
     nothing: a media query hides it there (base.css), and <noscript> says where the sommaire is.

     The field has NO NAME, on purpose. A named control is what a browser sends when a form is
     submitted by itself — and this field is in the page before the script that answers Enter:
     pressed a moment too early, or with that script lost on the way, Enter sent the words to
     the server in the address (`/?q=…`), where they stayed (security review of 14/11/2026,
     reproduced on the build in production). An unnamed control is never sent; the policy of
     public/_headers (`form-action 'none'`) stops the submission itself; scripts/e2e.ts and
     scripts/check-build.test.ts hold both. */
}
<form
  id="search"
  role="search"
  data-index={`/data/index-${version}.json`}
  data-meta={`/data/meta-${version}.json`}
  data-first-words={locatorDisplay()}
  data-words={wordsFinder}
>
  <label for="q">{asking ? t('chat.label') : t('search.label')}</label>
  <input
    id="q"
    type="search"
    autocomplete="off"
    autocapitalize="none"
    spellcheck="false"
    enterkeyhint="search"
    maxlength="300"
    placeholder={t('search.placeholder')}
    aria-describedby="search-hint"
  />
  {
    asking ? (
      <>
        {/* In its place from the first paint, and inert until the script that can answer a
            press has loaded: appearing then, it moved the lines under it. */}
        <button type="button" id="ask" aria-haspopup="dialog" disabled>
          {t('chat.send')}
        </button>
        {/* The notice, before the first use (AI Act, art. 50): what searching does, what asking
            does — sentences an AI wrote ahead — and, where a model answers, that it explains
            only when asked. */}
        <p id="search-hint" class="ref" data-local={`${t('search.hint')} ${t('search.local_promise')}`}>
          {model === null ? t('chat.hint') : t('chat.ai_hint', { model })}
        </p>
      </>
    ) : (
      <p id="search-hint" class="ref">
        {t('search.hint')} {t('search.local_promise')}
      </p>
    )
  }
</form>
{asking && ChatSheet !== null && <ChatSheet model={model} />}
<p id="search-status" role="status" class="ref"></p>{
  /* The line of an explained word (PLAN-MOTS, lot 6): on this line, so that a build without it
     keeps every byte of the page — a line of its own would leave a space. */
  __CEL_WORDS_SEARCH__ && <p id="search-word" hidden></p>
}
<section id="search-results" aria-labelledby="search-results-title" hidden>
  <h2 id="search-results-title" tabindex="-1">{t('search.results_title')}</h2>
  <ol id="search-list"></ol>
</section>
<noscript>
  <p>{toc ? t('search.no_js') : <a href="/sommaire/">{t('search.no_js')}</a>}</p>
</noscript>

<script type="application/json" id="search-strings" set:html={safeJson(strings)} is:inline />
{
  /*
    ONE processed script, outside any condition. Learning note — found by the end-to-end test on
    13/11/2026: a second <script> placed inside `{asking && …}` was bundled, but Astro numbered
    the two scripts in an order the page did not follow. With the mode "off" the page loaded the
    script of « Demander » instead of the search's, and the search silently never started.
    So the search script is the only one the page names. The sheet's script is fetched by it,
    at the first press of the button and never before (PLAN-CHAT §4) — and only in a build
    whose field asks: elsewhere the constant folds the whole block away.
  */
}
<script>
  import '../scripts/search.ts';
  if (__CEL_CHAT__) {
    const opener = document.querySelector<HTMLButtonElement>('#ask');
    if (opener !== null && document.querySelector('#chat-sheet') !== null) {
      // The sheet is a <dialog>: a browser that cannot open one (Safari before 15.4) gets no
      // button, and the notice of a page that only searches — never a button that does nothing.
      if ('showModal' in HTMLDialogElement.prototype) {
        opener.disabled = false;
        opener.addEventListener('click', () => {
          void import('../scripts/chat.ts').then((sheet) => {
            sheet.open();
          });
        });
      } else {
        opener.hidden = true;
        const hint = document.querySelector<HTMLElement>('#search-hint');
        if (hint?.dataset.local !== undefined) hint.textContent = hint.dataset.local;
      }
    }
  }
  // The line that says what is typed is an explained word (PLAN-MOTS, lot 6): only where the
  // build shows it — elsewhere the constant folds this away, and the script is the one of before.
  if (__CEL_WORDS_SEARCH__) {
    void import('../scripts/words-search.ts');
  }
  // The scrutin build's note (home page only): fetched the same way, for the same reason.
  if (document.querySelector('#scrutin-reopen') !== null) {
    void import('../scripts/scrutin-note.ts');
  }
</script>
