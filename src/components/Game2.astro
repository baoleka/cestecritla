---
/**
 * « Où est-ce écrit ? » — the game block of the home page, with the mascot of the second
 * generation (D17.1 to D17.25; docs/discovery/PLAN-TORTUE.md, lot C).
 *
 * The game is the game of the first generation's block (src/components/Game.astro, removed with
 * lot F: in the history of the repository), rule for rule: one word of the programme, a
 * question, the official titles as tiles, the card of the place. Never "wrong", never red, no
 * timer, no score. Without JavaScript the first round is here, whole, played with links and
 * `:target`. What changed is her:
 *
 *   - she is beside the word while one plays, and on a stage at the top of the panel when a
 *     round ends — ONE drawing, moved by the stylesheet (an attribute on the block), never
 *     moved in the document and never doubled (D17.9);
 *   - at the end of the round that earns it, she passes to her next form, once, and the
 *     passage can be skipped (D17.8); what will make her change is said in words, never in
 *     numbers (D17.5);
 *   - her sheet shows the forms she has had, replays a passage, and lets the player give her
 *     flamingo one of six colours, or none (D17.3).
 *
 * Imported by the home page in every build that shows the game (`__CEL_GAME__`). The block
 * still says its generation (`data-mascot="2"`): two were served side by side until lot F, and
 * the attribute stays because the stylesheets and the gates read it.
 *
 * What a visitor reads here that is the book's: the word (`data-programme="word"`) and the
 * official titles (`data-programme="title"`), whole, never cut. Everything else is ours, and
 * every number shown is computed from the list — none is typed, and none is about her.
 *
 * Since 18 November 2026 (docs/discovery/PLAN-JEU-DABORD.md) the block opens the home page
 * (D19.1), and its two screens changed shape:
 *
 *   - the six parts are a board, two tiles a row where two fit, each title whole with its
 *     number in bold — the same six places every time, so that one learns where they are;
 *   - the card says where, gives the way there, and — in a build that may (src/lib/game-gists.ts)
 *     — says what the measure provides, in ONE sentence of ours, under its own label: written
 *     and checked by an AI (D19.2). That sentence comes with the file of the game, by script:
 *     the round below, played without script, keeps the card without it (D19.6), and not a
 *     sentence of an AI is written in this page.
 *
 * Since 19 November 2026 a newcomer does not land on the board. The editor's two words that
 * day: « Le premier écran doit donner envie, sinon on remplace pas » (D19.15), then « Le premier
 * écran doit donner bien plus envie que le premier écran actuellement en ligne. C'est non
 * négociable » (D19.16). The entrance: THREE WORDS TO TOUCH — the three of the first round.
 * Touching one gives its card: where it is written, the way to the official page and, in a
 * build that may, what the measure provides. Nothing is asked for that word; the round goes on
 * with the two others, each with its question. Under the three words, the other door of the
 * site: the way to the search, and six of the fifteen themes people hear about.
 *
 * Why three: read head to head with the page that is online (thirteen simulated readers, the two
 * images side by side — docs/discovery/13-tests-humains.md §9.8), an entrance of ONE word lost,
 * 6 to 7: « a riddle I do not see the point of » for those who want to know at once what the
 * site is for. Three everyday words won 11 to 2: « a real list », « things of my life », and
 * « I only have to press ».
 *
 * Without script the same entrance, and the same round: each word is a link to its card, and
 * the anchors say where one stands in the round — `a` the word that was touched, `b` the second
 * word, `c` the third — so that the way on from a card is known without a script
 * (src/styles/game.css). The round goes round its three words from the one that was touched.
 */
import '../styles/game.css';
import '../styles/game2.css';
import Mascot2 from './Mascot2.astro';
import { pausedKey } from '../lib/ask-config.ts';
import { prose, ripostes } from '../lib/editorial.ts';
import { builtGame } from '../lib/game-built.ts';
import { gameSources, gameWords } from '../lib/game-data.ts';
import { DOOR_THEMES, doorRefusals } from '../lib/game-door.ts';
import { wordlessSections } from '../lib/game.ts';
import {
  ROUND,
  isLongWord,
  isShortWord,
  locate,
  otherParts,
  titleLead,
} from '../lib/game-engine.ts';
import { safeJson, t } from '../lib/strings.ts';

const { data, fingerprint } = builtGame();

const round = data.words.slice(0, ROUND);

/** `[1, 3, 5]` → « 1, 3 et 5 »: a list the way a sentence writes it. */
const list = (numbers: readonly number[]): string =>
  numbers.length < 2
    ? numbers.join('')
    : `${numbers.slice(0, -1).join(', ')} et ${String(numbers.at(-1))}`;

const words = round.map((word, index) => {
  const place = locate(data, word.section);
  if (place === null) throw new Error(`game: ${word.id} is shown in no tile`);
  const also = otherParts(data, word.id);
  return {
    ...word,
    n: index + 1,
    place,
    also,
    alsoLine:
      also.length === 0
        ? null
        : also.length === 1
          ? t('game.reveal.elsewhere_one', { n: also[0] ?? 0 })
          : t('game.reveal.elsewhere', { parts: list(also) }),
    // A count only when it says something: from three sections on (PLAN-JEU §4.1).
    countLine:
      word.places.length >= 3 ? t('game.reveal.count', { count: word.places.length }) : null,
    // The round goes round its words from the one that was touched: the word after this one.
    after: ((index + 1) % round.length) + 1,
  };
});

/** Where a word may stand in the round once the first was touched: second, or third. */
const ASKED = ['b', 'c'] as const;

const reveal = (ask: 'part' | 'chapter' | 'section') => ({
  yes: ask === 'part' ? t('game.reveal.yes', { n: '{n}' }) : ask === 'chapter' ? t('game.reveal.chapter.yes', { n: '{n}' }) : t('game.reveal.section.yes'),
  also: ask === 'part' ? t('game.reveal.also', { n: '{n}' }) : ask === 'chapter' ? t('game.reveal.chapter.also', { n: '{n}' }) : t('game.reveal.section.also'),
  neutral: ask === 'part' ? t('game.reveal.neutral', { n: '{n}' }) : ask === 'chapter' ? t('game.reveal.chapter.neutral', { n: '{n}' }) : t('game.reveal.section.neutral'),
});

/**
 * The six themes shown under the first gesture (src/lib/game-door.ts), as answers of ours —
 * published, and none that rests on a section no word of the game is taken from: they stand
 * on the same screen as her. The build stops on a list that breaks that rule.
 */
const doorSources = gameSources();
const sectionOfMeasure = new Map(
  doorSources.manifest.sections.flatMap((section) =>
    section.items.map((item) => [item.id, section.id] as const),
  ),
);
const refused = doorRefusals(
  DOOR_THEMES,
  ripostes(),
  wordlessSections(gameWords(), doorSources),
  (measure) => sectionOfMeasure.get(measure),
);
if (refused.length > 0) {
  throw new Error(`game: the themes under the first gesture\n  ${refused.join('\n  ')}`);
}
const door = ripostes().filter((entry) => DOOR_THEMES.includes(entry.slug));
door.sort((a, b) => DOOR_THEMES.indexOf(a.slug) - DOOR_THEMES.indexOf(b.slug));

/** This build puts our sentences on its cards (src/lib/game-gists.ts) — or none at all. */
const sentences = data.words.some((word) => word.gist !== undefined);

/** A line of ours, sentence by sentence: each on a line of its own where it is said so. */
const sentencesOf = (text: string): string[] => text.split(/(?<=[.!?…])\s+/u);

/** An official title, whole: its number in bold where it has one (`titleLead`). */
const titled = (title: string): [string, string] => [
  title.slice(0, titleLead(title)),
  title.slice(titleLead(title)),
];

const config = {
  data: `/data/jeu-${fingerprint}.json`,
  strings: {
    // The label of a sentence, in a build that shows sentences — and only there: a page of a
    // site that asks nothing names no AI (scripts/check-no-ai-mention.test.ts).
    ...(sentences ? { gist: t('game.gist.badge') } : {}),
    kicker: t('game.kicker'),
    // The entrance (D19.15, D19.16): what a newcomer reads above and under the three words of
    // the first round, and what completes the name of each for a screen reader.
    start: {
      // Sentence by sentence, cut here: the script that draws them carries no look-behind,
      // which Safari refused until 16.4 — a syntax error there would take the whole game.
      hook: sentencesOf(t('game.start.hook')),
      cta: t('game.start.cta'),
      source: t('game.start.source'),
    },
    ask: {
      part: t('game.question.part'),
      chapter: t('game.question.chapter'),
      section: t('game.question.section'),
    },
    reveal: { part: reveal('part'), chapter: reveal('chapter'), section: reveal('section') },
    dontKnow: t('game.dont_know'),
    hint: t('game.hint.cta'),
    hintMark: t('game.hint.mark'),
    hintSaid: t('turtle.hint.said', { parts: '{parts}' }),
    also: t('game.reveal.elsewhere', { parts: '{parts}' }),
    alsoOne: t('game.reveal.elsewhere_one', { n: '{n}' }),
    count: t('game.reveal.count', { count: '{count}' }),
    cta: t('game.reveal.cta'),
    next: t('game.next_word'),
    done: t('game.round.done'),
    again: t('game.round.again'),
    ahead: t('game.round.ahead'),
    share: t('game.share'),
    copied: t('share.toast_copied'),
    // « Tu te souviens ? » (lot 6): two words already found, whose card one opens again.
    recall: { title: t('game.recall.title'), lead: t('game.recall.lead') },
    depth: { 2: t('game.depth.chapter'), 3: t('game.depth.section') },
    keep: {
      what: t('turtle.keep.what'),
      tint: t('turtle.keep.tint'),
      // « Tes réponses », not « Tes choix »: her colour is a choice, and it is kept (D17.30).
      notKept: t('turtle.keep.not_kept.tint'),
      otherwise: t('turtle.keep.otherwise'),
      seen: t('turtle.keep.seen'),
      safari: t('turtle.keep.safari'),
      erase: t('turtle.keep.erase'),
      open: t('turtle.keep.open'),
      cta: t('turtle.keep.cta'),
      decline: t('turtle.keep.decline'),
      done: t('turtle.keep.done'),
    },
    sheet: {
      name: t('turtle.button'),
      none: t('turtle.sheet.none'),
      onPhone: t('turtle.sheet.on_phone'),
      onPhoneTint: t('turtle.sheet.on_phone_tint'),
      tabOnly: t('turtle.sheet.tab_only'),
      released: t('turtle.released'),
      erased: t('turtle.erased'),
      replay: t('turtle.sheet.replay'),
      skip: t('turtle.skip'),
      foundLead: t('turtle.found.lead'),
    },
    // Her goal, in words (D17.5): the sentence the game says is picked by src/lib/game-goal.ts.
    goal: {
      start: t('turtle.goal.start'),
      parts: t('turtle.goal.parts'),
      chapters: t('turtle.goal.chapters'),
      words: t('turtle.goal.words'),
      done: t('turtle.goal.done'),
      next: t('turtle.goal.next'),
      next_again: t('turtle.goal.next_again'),
    },
    // What happened to her, passage by passage — said when the passage has been seen (D17.6).
    passage: {
      1: t('turtle.passage.1'),
      2: t('turtle.passage.2'),
      3: t('turtle.passage.3'),
      4: t('turtle.passage.4'),
    },
    // What she does when touched, by her form (D17.25): what a screen reader says of it.
    figure: {
      0: t('turtle.raises_head'),
      1: t('turtle.figure.surf'),
      2: t('turtle.figure.wings'),
      3: t('turtle.figure.wings'),
      4: t('turtle.figure.sky'),
    },
    // The colour of her flamingo, by its name and never by a part of the book (D17.23).
    tints: {
      1: t('turtle.tint.1'),
      2: t('turtle.tint.2'),
      3: t('turtle.tint.3'),
      4: t('turtle.tint.4'),
      5: t('turtle.tint.5'),
      6: t('turtle.tint.6'),
      7: t('turtle.tint.none'),
    },
  },
};
---

{
  /* Electoral silence (D16.16): the block below is not shown at all, and this sentence says
     what is paused. Shown by the attribute the guard in the <head> sets before the first paint,
     and by the script once it has read the hour of our server. */
}
<p
  class="g-silence"
  id="game-silence"
  data-reason={t('silence.reason')}
  data-reopen={t('silence.reopen', { reopenTime: '{reopenTime}' })}
>
  {t(pausedKey())}
  <span id="game-reopen"></span>
</p>

<section class="game" id="jeu" aria-labelledby="game-title" data-mascot="2">
  <h2 id="game-title">{t('game.title')}</h2>
  {
    /* Her, once, whatever the screen: beside the word, then on the stage — the stylesheet moves
       her (`data-stage` on the block), the document never does. */
  }
  <div class="g-her" id="game-her"><Mascot2 /></div>
  {
    /* Under the stage, at the end of a round, and only with script: the way to her sheet (none
       of the personas guessed that she can be touched) — in whose place the way past a passage
       stands while one plays — and, once she is a flamingo that has no colour yet, the way to
       give her one. */
  }
  <p class="g-her-with" id="game-her-with" hidden>
    <span class="g-swap">
      <button type="button" class="g-quiet" id="game-sheet-link" aria-haspopup="dialog">
        {t('turtle.sheet.link')}
      </button>
      <button type="button" class="g-quiet" id="game-skip" data-wait>{t('turtle.skip')}</button>
    </span>
    <button type="button" class="g-quiet" id="game-tint-link" aria-haspopup="dialog" hidden>
      {t('turtle.tint.choose')}
    </button>
  </p>

  <div class="g-static" id="game-static">
    {
      /* Position anchors, before everything they command: `:target ~ …` reads forwards only.
         For each word: `a` its card when it was the word touched; then, where it is the
         second word of the round (`b`) or the third (`c`), its question and the card each
         tile leads to. */
      words.map((word) => (
        <>
          <span class={`g-at g-r g-a g-w${String(word.n)}`} id={`a${String(word.n)}`} />
          {ASKED.map((at) => (
            <>
              <span class={`g-at g-${at} g-w${String(word.n)}`} id={`${at}${String(word.n)}`} />
              <span
                class={`g-at g-r g-${at} g-w${String(word.n)}`}
                id={`${at}${String(word.n)}-0`}
              />
              {data.parts.map((part) => (
                <span
                  class:list={[
                    'g-at',
                    'g-r',
                    `g-${at}`,
                    `g-w${String(word.n)}`,
                    part.number === word.place.part.number && 'g-here',
                    word.also.includes(part.number) && 'g-there',
                  ]}
                  id={`${at}${String(word.n)}-${String(part.number)}`}
                />
              ))}
            </>
          ))}
        </>
      ))
    }
    <span class="g-at g-over" id="fin"></span>

    {
      /* The entrance (D19.15, D19.16): three words to touch, then the other door of the site.
         A word and nothing around it, not even a space: its guillemets are drawn by the
         stylesheet, and the script writes the same element without one. */
    }
    <div class="g-enter">
      <p class="g-lead">
        {sentencesOf(t('game.start.hook')).map((sentence) => (
          <span>{sentence}</span>
        ))}
      </p>
      <ul class="g-pick">
        {
          words.map((word) => (
            <li>
              <a class="g-pick-word" href={`#a${String(word.n)}`}>
                <span class="g-picked" data-programme="word">{word.word}</span>
                <span class="g-go" aria-hidden="true" />
                <span class="sr-only">{t('game.start.cta')}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="g-how">{t('game.start.source')}</p>
      <div class="g-door" id="game-door">
        <h3>{t('game.start.find')}</h3>
        <p>
          <a class="g-find" href="#chercher">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="M15.5 15.5 21 21" />
            </svg>
            {t('home.direct.cta_search')}
          </a>
        </p>
        <ul>
          {
            door.map((entry) => (
              <li>
                <a
                  class="g-quiet"
                  href={`/r/${entry.slug}/`}
                  aria-label={`${entry.theme} : ${prose(entry.objection)}`}
                >
                  {entry.theme}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      words.map((word) => (
        <div class={`g-word g-word-${String(word.n)}`}>
          {/* The room of what is said of her before a round has ended — so that nothing moves
              when the script takes the block. Shown from the first paint only where the
              browser says a script can run (src/styles/game2.css): without script she does
              not change, and the page must not say that she will. */}
          <p class="g-goal" data-wait>{t('turtle.goal.start')}</p>
          <p class="g-kicker">{t('game.kicker')}</p>
          <p
            class="g-the-word"
            data-programme="word"
            data-long={isLongWord(word.word) ? '' : undefined}
            data-short={isShortWord(word.word) ? '' : undefined}
          >{word.word}</p>
          {
            /* Its question, once for each place it may have in the round: the tiles of one
               lead to cards that know the way on, and those of the other to the end. */
            ASKED.map((at) => (
              <div class={`g-question g-q${at}`}>
                <h3 class="g-ask">{t('game.question.part')}</h3>
                <p class="g-with">
                  <a class="g-quiet" href={`#${at}${String(word.n)}-0`}>
                    {t('game.dont_know')}
                  </a>
                  {/* The room of « Un indice », which only the script can offer (D19.7): kept from
                      the first paint, so that nothing moves when the script takes the block. */}
                  <span class="g-quiet" data-wait>{t('game.hint.cta')}</span>
                </p>
                <ul class="g-tiles g-board">
                  {data.parts.map((part) => (
                    <li>
                      <a class="g-tile" href={`#${at}${String(word.n)}-${String(part.number)}`}>
                        <span data-programme="title"><b>{titled(part.title)[0]}</b>{titled(part.title)[1]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div class="g-place">
            <h3 class="g-yes">{t('game.reveal.yes', { n: word.place.part.number })}</h3>
            <h3 class="g-also">{t('game.reveal.also', { n: word.place.part.number })}</h3>
            <h3 class="g-neutral">{t('game.reveal.neutral', { n: word.place.part.number })}</h3>
            <ul class="g-where">
              <li data-programme="title">{word.place.part.title}</li>
              <li data-programme="title">{word.place.chapter.title}</li>
              <li data-programme="title">{word.place.section.title}</li>
            </ul>
            {word.alsoLine !== null && <p>{word.alsoLine}</p>}
            {word.countLine !== null && <p>{word.countLine}</p>}
            {/* The way to the book, attached to the place (D19.10) — then, alone at the foot of
                the card, the way on. With script, the sentence of the measure stands between
                the two, under its own label: never under « C'est écrit là » (D16.64). */}
            <p class="g-official">
              <a
                class="cta"
                href={word.url}
                rel="noopener noreferrer"
                data-fragment={word.fragment === '' ? undefined : word.fragment}
              >
                {t('game.reveal.cta')}
              </a>
            </p>
            {/* The way on: to the question of the next word — or, after the third, to the end.
                One link shows, by where the card stands in the round. */}
            <p class="g-actions">
              <a class="g-next g-next-a" href={`#b${String(word.after)}`}>
                {t('game.next_word')}
              </a>
              <a class="g-next g-next-b" href={`#c${String(word.after)}`}>
                {t('game.next_word')}
              </a>
              <a class="g-next g-next-c" href="#fin">
                {t('game.next_word')}
              </a>
            </p>
          </div>
        </div>
      ))
    }
    <div class="g-end">
      <h3>{t('game.round.done')}</h3>
      <p>
        <a href="/sommaire/">{t('game.round.no_js')}</a>
      </p>
    </div>
  </div>

  <div class="g-live" id="game-live" hidden></div>
  <p class="sr-only" id="game-status" role="status"></p>

  {
    /* Her sheet (D16.13, D17.8, D17.3): opened by touching her or by « Sa fiche », so only ever
       by the script. Inside she is large and can be touched again; one reads what will make her
       change, sees the forms she has had — never one to come — and can see a passage again;
       gives her flamingo a colour; reads what she has found, what is kept, and the gesture that
       erases everything. */
  }
  <dialog class="t-sheet" id="turtle-sheet" aria-labelledby="turtle-sheet-title">
    <h3 id="turtle-sheet-title" tabindex="-1">{t('turtle.button')}</h3>
    <div class="t-sheet-her" id="turtle-sheet-her"></div>
    <p class="t-sheet-said" id="turtle-sheet-said" role="status"></p>
    <p class="t-sheet-goal" id="turtle-sheet-goal"></p>
    {/* « Son parcours » is there once she has made a passage: before, there is nothing to tell. */}
    <div id="turtle-sheet-way" hidden>
      <h4>{t('turtle.sheet.path')}</h4>
      <ol class="t-path" id="turtle-sheet-path"></ol>
    </div>
    <div id="turtle-sheet-tint" role="group" aria-labelledby="turtle-sheet-tint-title" hidden>
      <h4 id="turtle-sheet-tint-title">{t('turtle.tint.title')}</h4>
      <ul class="t-tints" id="turtle-sheet-tints"></ul>
    </div>
    <h4>{t('turtle.sheet.found')}</h4>
    <div id="turtle-sheet-found"></div>
    <h4>{t('turtle.sheet.kept')}</h4>
    <div id="turtle-sheet-kept"></div>
    <p class="g-actions">
      <button type="button" class="g-quiet" id="turtle-sheet-keep" hidden>
        {t('turtle.keep.cta')}
      </button>
      <button type="button" class="g-quiet" id="turtle-sheet-release" hidden>
        {t('turtle.release')}
      </button>
      <button type="button" class="g-quiet" id="turtle-sheet-erase">{t('turtle.erase')}</button>
    </p>
    <p><a href="/confidentialite/#ce-que-le-jeu-ecrit">{t('turtle.sheet.privacy')}</a></p>
    <form method="dialog">
      <button class="g-quiet">{t('common.close')}</button>
    </form>
    {/* Her sheet lists words of the programme: it carries the label itself — held to its lower
        edge (src/styles/game2.css), so that no capture of it alone can be shown without it,
        however far it is scrolled. */}
    <p class="unofficial">{t('independence.unofficial')}</p>
  </dialog>
  <script type="application/json" id="game-config" set:html={safeJson(config)} is:inline />
</section>

<script>
  import '../scripts/game2.ts';
</script>
