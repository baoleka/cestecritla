---
/**
 * The withdrawal page (D14.10, D21.17) — what cestecritla.fr serves once the editor withdraws
 * the site: `npm run build:holding && npm run deploy`.
 *
 * Its text is the editor's, word for word (D21.17, 24/11/2026). Until then it was the holding
 * page of September (D15.4), written while the app moved to the 2026 edition: « Ce site
 * s'appuyait sur l'édition 2025. Il se met à jour. » — false of a withdrawal, the only use the
 * holding build has had since the launch of 14/11/2026 (review of 24/11/2026, C17, L6, U10).
 *
 * What it must never contain: a single word of the programme, or a licence line. The link to the
 * book is the whole point — the legal notice of the source "authorises (and encourages)" links.
 * The legal notice stays served with it, and this page leads to it (D21.18): the host's name and
 * address are the condition of the editor's anonymity (LCEN art. 1-1 II, `11-conformite.md`).
 *
 * Old links are redirected here by dist/_redirects, written by scripts/build.ts --holding.
 *
 * Not indexed: a withdrawn site is not a page one should find by a search.
 */
import Base from '../../layouts/Base.astro';
import { t } from '../../lib/strings.ts';

/** The 2026 book. Answers 200; the 2025 URL now redirects to it (observed 12/11/2026). */
const BOOK_URL = 'https://melenchon2027.fr/programme/livre/';

/**
 * The same frame serves two moments, each with the editor's own words: the withdrawal (D21.17)
 * and a re-edition of the programme, while the site is brought up to date (D21.37) —
 * `npm run build:update`. A withdrawn site does not say it is updating; an updating one does
 * not say it is withdrawn.
 */
const updating = process.env.CEL_HOLDING === 'update';
const said = updating
  ? 'L’Avenir en commun a été réédité. Ce site se met à jour.'
  : 'Ce site est retiré.';
const description = `Site non officiel. ${said}`;
---

<Base title="C'est écrit là" description={description} noindex>
  <p class="label">Site non officiel.</p>
  <h1>C’est écrit là</h1>
  {
    updating ? (
      <p>
        <cite>L’Avenir en commun</cite> a été réédité. Ce site se met à jour.
      </p>
    ) : (
      <>
        <p>Ce site est retiré.</p>
        <p>
          <cite>L’Avenir en commun</cite> se lit sur le site officiel.
        </p>
      </>
    )
  }
  <p>
    <a class="cta" href={BOOK_URL} rel="noopener noreferrer">Lire le programme sur melenchon2027.fr</a>
  </p>
  <p><small>Projet militant indépendant.</small></p>
  <p><small><a href="/mentions-legales/">{t('legal.notice')}</a></small></p>
</Base>
