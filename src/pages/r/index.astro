---
/**
 * `/r/` — the objections, listed. Each one links to what the text says about it.
 */
import Base from '../../layouts/Base.astro';
import { prose, ripostes } from '../../lib/editorial.ts';
import { t } from '../../lib/strings.ts';

const entries = ripostes();
---

<Base title={`${t('riposte.title')} — ${t('app.name')}`} description={t('riposte.lead')}>
  <h1>{t('riposte.title')}</h1>
  <p class="lead">{t('riposte.index_lead', { count: entries.length })}</p>
  <ul class="toc">
    {
      entries.map((entry) => (
        <li>
          <a href={`/r/${entry.slug}/`}>{prose(entry.objection)}</a>
        </li>
      ))
    }
  </ul>
</Base>
