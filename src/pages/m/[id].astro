---
/**
 * `/m/<id>` — bridges for the measures of the 2025 edition (D15.8).
 *
 * This prefix used to serve one page per proposition, with its text. The 2026 edition gives no
 * right to do that (D15.1): a proposition is now reached by a deep link into the official page,
 * from its section's pointer page. What remains here are the 837 old addresses, each answering
 * with a bridge to the section where the subject is treated now.
 */
import Bridge from '../../components/Bridge.astro';
import { oldMeasures } from '../../lib/archive-2025.ts';

export function getStaticPaths() {
  return oldMeasures().map((old) => ({
    params: { id: old.id },
    props: { sectionId: old.sectionId },
  }));
}
const { sectionId } = Astro.props;
---

<Bridge path={`m/${Astro.params.id}`} sectionId={sectionId} />
