---
/**
 * `/mot/` — the words of the programme that need explaining, listed.
 */
import Base from '../../layouts/Base.astro';
import { cards, prose } from '../../lib/editorial.ts';
import { t } from '../../lib/strings.ts';
---

<Base title={`${t('nav.words')} — ${t('app.name')}`} description={t('concept.index_lead')}>
  <p class="label">{t('independence.unofficial')}</p>
  <h1>{t('nav.words')}</h1>
  <p class="lead">{t('concept.index_lead')}</p>
  <ul class="toc">
    {
      cards().map((card) => (
        <li>
          <a href={`/mot/${card.id}/`}>{prose(card.term)}</a>
        </li>
      ))
    }
  </ul>
</Base>
