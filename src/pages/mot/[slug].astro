---
/**
 * `/mot/<slug>/` — a concept card: a word of the programme, in plain language, then in the
 * programme's own words, then why it matters and what is said against it.
 *
 * "En clair" comes first and is labelled as ours: a reformulation that passed for the text
 * would be the one fault this whole project exists to avoid.
 */
import Authorship from '../../components/Authorship.astro';
import Base from '../../layouts/Base.astro';
import Supports from '../../components/Supports.astro';
import { cards, prose, resolve, type Card } from '../../lib/editorial.ts';
import { t } from '../../lib/strings.ts';
import { pageWordsFile } from '../../lib/words-built.ts';

export function getStaticPaths() {
  return cards().map((card: Card) => ({ params: { slug: card.id }, props: { card } }));
}

const { card } = Astro.props;
const supports = resolve(`mot:${card.id}`, card.supports);
const all = cards();
const related = card.related
  .map((id) => all.find((c) => c.id === id))
  .filter((c): c is Card => c !== undefined);
const term = prose(card.term);
// The explained words of the card (PLAN-MOTS, lot 4), where the build shows them on its pages.
const Words = __CEL_WORDS_PAGES__ ? (await import('../../components/Words.astro')).default : null;
const wordsFile = Words === null ? null : pageWordsFile('c', card.id);
const title = term.charAt(0).toUpperCase() + term.slice(1);
// A short card says what the programme calls so, and no more (D20.5): neither why it matters
// nor an objection — the measure it rests on is listed below. Below, each block is one line
// that ends on a space: Astro keeps the whitespace before an expression and drops the one after
// it, and this way the cards of before are the same pages, byte for byte.
const why = card.why;
const objection = card.objection;
---

<Base
  title={`${title} — ${t('app.name')}`}
  description={`${t('meta.ai_prepared')} ${prose(card.plain)}`}
  verbatim={supports.some((s) => s.quote !== null)}
>
  <p class="where">{t('nav.words')}</p>
  <h1>{title}</h1>

  <h2>{t('concept.label.plain')}</h2>
  <p class="lead">{prose(card.plain)}</p>

  {why !== undefined && <><h2>{t('concept.label.why')}</h2> <p>{prose(why)}</p> </>}
  {objection !== undefined && <><h2>{t('concept.label.objection')}</h2> <p>«&nbsp;{prose(objection.text)}&nbsp;»</p> <p>{prose(objection.answer)}</p> </>}

  <Supports supports={supports} />

  {Words !== null && wordsFile !== null && <Words file={wordsFile} title="words.page.title" />}

  {
    related.length > 0 && (
      <>
        <h2>{t('concept.label.related_terms')}</h2>
        <ul class="toc">
          {related.map((other) => (
            <li>
              <a href={`/mot/${other.id}/`}>{prose(other.term)}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <Authorship review={card.review} />
  <p><a href="/mot/">{t('nav.words')}</a></p>
</Base>
