---
/**
 * `/methodologie/` — how the app knows where a measure is written without copying the book.
 */
import Base from '../../layouts/Base.astro';
import { manifest } from '../../lib/edition.ts';
import { fr, t } from '../../lib/strings.ts';

const counts = manifest().meta.counts;
// One request per page the table of contents publishes (introduction, parts, chapters), plus
// robots.txt, the table itself, the legal notice, the page announcing the count, and the feed.
const requests = 1 + counts.parts + counts.chapters + 5;
---

<Base title={`${t('method.title')} — ${t('app.name')}`} description={t('method.intro')}>
  <h1>{t('method.title')}</h1>
  <p class="lead">{t('method.intro')}</p>

  <h2>{t('method.steps_title')}</h2>
  <ol class="counts">
    <li>{t('method.step.01', { count: fr(requests) })}</li>
    <li>{t('method.step.02')}</li>
    <li>{t('method.step.03')}</li>
    <li>{t('method.step.04')}</li>
    <li>{t('method.step.05')}</li>
  </ol>
  <p>{t('method.watch')}</p>

  <h2>{t('method.hash.title')}</h2>
  <p>{t('method.hash.text')}</p>

  <h2>{t('method.writing_title')}</h2>
  <p>{t('about.no_ai')}</p>
  <p>{t('about.writing_method')}</p>
  <p>{t('legal.license.code')}</p>

  <p><a href="/exactitude/">{t('accuracy.title')}</a></p>
</Base>
