---
/**
 * Home: the game first (D19.1, which amends D16.1).
 *
 * The page opens on « Où est-ce écrit ? ». Searching and asking stay on it, below, in a section
 * of their own that the header leads to (« Chercher »): one more feature of the page, no longer
 * its first screen. Its <h1> is the name, in the header every page shares.
 *
 * In reading order:
 *
 *   1. whose programme this is, and whose site — one small line, before anything else: said on
 *      the first screen because none of the seven personas could tell (session of 14/11/2026),
 *      and above the game because a game about a programme must say whose it is first;
 *   2. the game (src/components/Game2.astro), in a build that shows it;
 *   3. the section « Chercher »: the field, « Demander au programme » where the site asks, the
 *      results, the way to the table of contents, and the fifteen answers as chips (lot H3).
 *
 * She — the mascot — lives in the block of the game and nowhere else (D17.9); the field is one
 * phone screen further down (D19.9: the block of the game is at least as tall as the window,
 * src/styles/game2.css), so that she is never on screen next to it.
 *
 * During an electoral silence the game is not shown (D16.16), and the section below simply
 * comes up: the page is then where one searches and reads, as the law allows. The "scrutin"
 * build has no game at all.
 *
 * The table of contents has its own page, /sommaire/. It is still the navigation for a browser
 * without JavaScript: the header leads to it there, and the sentence the search leaves behind
 * is a link to it.
 */
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import Search from '../components/Search.astro';
import { pausedKey } from '../lib/ask-config.ts';
import { silenceGuardHash, silenceGuardScript } from '../lib/silence-guard.ts';
import { t } from '../lib/strings.ts';

// The game is imported only by a build that shows it (astro.config.ts): `__CEL_GAME__` is a
// constant the bundler folds, so that without the game neither its stylesheet nor its script
// reaches the page or dist/.
//
// The block is Game2.astro: the game with the mascot of the second generation, the one served
// since 15 November 2026 (D17.36). The first generation was removed from the repository with
// lot F of docs/discovery/PLAN-TORTUE.md; the block kept its name, because the files a build
// publishes are named after it.
const Game = __CEL_GAME__ ? (await import('../components/Game2.astro')).default : null;

// Electoral silence (D16.16). A page that shows the game hides it before its first paint when
// the device's clock is in a silence window: a few synchronous lines in the <head>, allowed by
// their hash and by nothing wider (src/lib/silence-guard.ts). The "scrutin" build, deployed
// before each window, has no game to hide: it says in one sentence what is paused, and why.
const guard = __CEL_GAME__ ? silenceGuardScript() : null;
if (guard !== null) Astro.csp.insertScriptHash(silenceGuardHash());
---

<Base
  title={t('app.name')}
  description={Game !== null ? t('home.description') : t('home.tagline')}
  home
  word={Game !== null}
>
  {guard !== null && <script is:inline slot="head" set:html={guard} />}
  {/* Whose programme, and whose site: the first line of the page, small — never its hero. */}
  <p class="what">{t('home.what')}</p>
  {
    /* The scrutin build has no game to hide: it says what is paused and why — and, once its
       script has read the hour, until when (D16.41: six personas out of seven asked). Without
       script the hour is simply not said. */
    __CEL_SCRUTIN__ && (
      <p id="scrutin-note">
        {t(pausedKey())} {t('silence.reason')}{' '}
        <span
          id="scrutin-reopen"
          data-reopen={t('silence.reopen.after', { reopenTime: '{reopenTime}' })}
        />
      </p>
    )
  }
  {/* The game opens the page (D19.1). */}
  {Game !== null && <Game />}
  {
    /* Searching and asking: one section, below the game, that the header leads to. Its field is
       in the page from the first paint, as before (src/components/Search.astro) — only lower. */
  }
  <section class="find" id="chercher" aria-labelledby="chercher-titre">
    <div class="find-head">
      <h2 id="chercher-titre">{t('nav.search')}</h2>
      <a class="find-toc" href="/sommaire/">{t('nav.toc')}</a>
    </div>
    <Search ask />
    <Chips />
  </section>
</Base>
