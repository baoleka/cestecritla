---
/**
 * Home: the field first (D16.1, D16.9).
 *
 * The page is where one asks and where one searches; the game comes below it. Its <h1> is the
 * name, in the header every page shares, so the first thing under the header is the field — no
 * lead in between: the label of the field says what it is for.
 *
 * Under the field, the fifteen answers a person wrote and re-read, as chips (lot H3).
 *
 * The table of contents has its own page, /sommaire/, one tap away in the header. It is still
 * the navigation for a browser without JavaScript: the sentence the search leaves behind there
 * is a link to it.
 */
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import Search from '../components/Search.astro';
import { askSite } from '../lib/ask-config.ts';
import { t } from '../lib/strings.ts';

// Turnstile is the one third-party origin the site ever opens, and it opens it here only: on
// the page that carries the field, and only when the site answers questions (D7.6, D16.8).
// Every other page keeps a policy that allows nothing but our own origin.
//
// Learning note — naming one script source replaces Astro's default instead of adding to it:
// `'self'` disappears, and our own bundled scripts would be refused by our own policy. Both
// are therefore named. (The `frame-src` directive comes out repeated in the meta tag — Astro
// writes an inserted directive after each of its own; a browser reads the first and ignores
// the rest. scripts/check-build.test.ts holds what the policy allows, not how it is spelled.)
if (askSite().mode !== 'off') {
  Astro.csp.insertScriptResource("'self'");
  Astro.csp.insertScriptResource('https://challenges.cloudflare.com');
  Astro.csp.insertDirective('frame-src https://challenges.cloudflare.com');
}
---

<Base title={t('app.name')} description={t('home.tagline')} home>
  <Search ask />
  <Chips />
</Base>
