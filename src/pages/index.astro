---
/**
 * Home: the field first (D16.1, D16.9).
 *
 * The page is where one asks and where one searches; the game comes below it. Its <h1> is the
 * name, in the header every page shares, so the first thing under the header is the field — no
 * lead in between: the label of the field says what it is for.
 *
 * Under the field, the fifteen answers a person wrote and re-read, as chips (lot H3).
 *
 * The table of contents has its own page, /sommaire/, one tap away in the header. It is still
 * the navigation for a browser without JavaScript: the sentence the search leaves behind there
 * is a link to it.
 */
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import Search from '../components/Search.astro';
import { pausedKey } from '../lib/ask-config.ts';
import { silenceGuardHash, silenceGuardScript } from '../lib/silence-guard.ts';
import { t } from '../lib/strings.ts';

// The game is imported only by a build that shows it (astro.config.ts): `__CEL_GAME__` is a
// constant the bundler folds, so that without the game neither its stylesheet nor its script
// reaches the page or dist/.
const Game = __CEL_GAME__ ? (await import('../components/Game.astro')).default : null;

// Electoral silence (D16.16). A page that shows the game hides it before its first paint when
// the device's clock is in a silence window: a few synchronous lines in the <head>, allowed by
// their hash and by nothing wider (src/lib/silence-guard.ts). The "scrutin" build, deployed
// before each window, has no game to hide: it says in one sentence what is paused, and why.
const guard = __CEL_GAME__ ? silenceGuardScript() : null;
if (guard !== null) Astro.csp.insertScriptHash(silenceGuardHash());

---

<Base title={t('app.name')} description={t('home.tagline')} home>
  {guard !== null && <script is:inline slot="head" set:html={guard} />}
  <Search ask />
  {/* Whose programme, and whose site: said on the first screen, under the field — none of the
      seven personas could tell from it (session of 14/11/2026). Results, when there are some,
      come between the field and this line: a keyboard leaves little room under a field. */}
  <p class="what">{t('home.what')}</p>
  <Chips />
  {
    /* The scrutin build has no game to hide: it says what is paused and why — and, once its
       script has read the hour, until when (D16.41: six personas out of seven asked). Without
       script the hour is simply not said. */
    __CEL_SCRUTIN__ && (
      <p id="scrutin-note">
        {t(pausedKey())} {t('silence.reason')}{' '}
        <span
          id="scrutin-reopen"
          data-reopen={t('silence.reopen.after', { reopenTime: '{reopenTime}' })}
        />
      </p>
    )
  }
  {/* The game comes below: the second screen of the page, never the first (D16.1). */}
  {Game !== null && <Game />}
</Base>
