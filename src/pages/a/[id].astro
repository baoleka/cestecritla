---
/**
 * `/a/<id>` — bridges for the "À savoir" statistics of the 2025 edition (D15.8, D15.10).
 *
 * The 2026 edition has no "À savoir" box at all, so the statistic cards and the legal sidecar
 * of law 77-808 that came with them left the product. Their 48 addresses stay answered.
 */
import Bridge from '../../components/Bridge.astro';
import { oldStatistics } from '../../lib/archive-2025.ts';

export function getStaticPaths() {
  return oldStatistics().map((old) => ({
    params: { id: old.id },
    props: { sectionId: old.sectionId },
  }));
}
const { sectionId } = Astro.props;
---

<Bridge path={`a/${Astro.params.id}`} sectionId={sectionId} />
