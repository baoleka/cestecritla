---
/**
 * The one document shell. Everything the accessibility gate checks at the document level is
 * decided here: lang, a single <main>, the viewport rule, and the theme colours.
 *
 * Two builds share it (D15.4): the app, and the holding site of src/holding/. The holding page
 * gets the bare shell — no site header, no footer navigation, no social tags — because none of
 * the pages those would point at exist in that build.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import { t } from '../lib/strings.ts';

interface Props {
  title: string;
  description?: string | undefined;
  /**
   * Set by pages that render a verbatim block, the only place Gowun Batang is used.
   *
   * It used to be preloaded on every page: 19 652 bytes fetched at high priority by the home
   * page, the 404 and the reserved pages, none of which draw a single glyph with it. A preload
   * is a promise that the first screen needs the file — design/perf-budget.md §1.7 says so in
   * as many words — so it is opt-in.
   */
  verbatim?: boolean | undefined;
  /**
   * Keeps a page out of search indexes. The launch playbook opens indexing at J-3 and not
   * before (12-positionnement-lancement.md §9.4.3); until then nothing we serve should be found
   * by a search rather than by a link someone chose to send. Bridges for the addresses of the
   * 2025 edition stay out of indexes for good: they are signposts, not pages.
   */
  noindex?: boolean | undefined;
  /** On the home page the name in the header is the <h1>; elsewhere it is the way back. */
  home?: boolean | undefined;
  /** The table of contents: the header link then names the current page instead of leading to it. */
  toc?: boolean | undefined;
}
const {
  title,
  description,
  verbatim = false,
  noindex = false,
  home = false,
  toc = false,
} = Astro.props;

const holding = process.env.CEL_BUILD === 'holding';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const footer: readonly { href: string; label: string }[] = [
  { href: '/sommaire/', label: t('nav.toc') },
  { href: '/r/', label: t('riposte.title') },
  { href: '/mot/', label: t('nav.words') },
  { href: '/exactitude/', label: t('legal.accuracy') },
  { href: '/methodologie/', label: t('nav.method') },
  { href: '/licence/', label: t('legal.license') },
  { href: '/confidentialite/', label: t('legal.privacy') },
  { href: '/a-propos/', label: t('legal.about') },
  { href: '/mentions-legales/', label: t('legal.notice') },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    {/*
      A2 / ban list: no user-scalable=no AND no maximum-scale below 5. Both block zoom, and the
      second is the one style guides forget.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="color-scheme" content="light dark" />
    {/* A3: one theme-color per media, so the browser chrome follows the system, with no JS. */}
    <meta name="theme-color" content="#FFFCF4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#212320" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      !holding && (
        <>
          {/* Our own address, never the official one: a cross-domain canonical would declare
              that the official site owns this page and ask for ours to be de-indexed. */}
          <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
          <link rel="canonical" href={canonical} />
          {/* Link previews carry our words only — never an extract of the programme (D15.7). */}
          <meta property="og:site_name" content={t('app.name')} />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content="fr_FR" />
          <meta property="og:image" content={new URL('/og/cestecritla-v1.png', Astro.site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {/* P1: the faces of the first screen are preloaded; the italic is not shipped at all. */}
    <link
      rel="preload"
      href="/fonts/PublicSans-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      verbatim && (
        <link
          rel="preload"
          href="/fonts/GowunBatang-Regular-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
  </head>
  <body>
    {
      /*
        The frame of every screen (D16.1): the name, « Site non officiel. » and the way to the
        table of contents stay in view at any scroll height — so that a screenshot taken anywhere
        on the page still says whose page it is not.
      */
      !holding && (
        <header class="site">
          <div class="site-bar">
            <div class="site-id">
              {home ? (
                <h1 class="wordmark">{t('app.name')}</h1>
              ) : (
                <a class="wordmark" href="/">
                  {t('app.name')}
                </a>
              )}
              <p class="unofficial">{t('independence.unofficial')}</p>
            </div>
            <a class="site-toc" href="/sommaire/" aria-current={toc ? 'page' : null}>
              {t('nav.toc')}
            </a>
          </div>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    {
      !holding && (
        <footer class="site">
          <nav aria-label="Pages du site">
            <ul>
              {footer.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <p class="ref">{t('independence.line')}</p>
        </footer>
      )
    }
  </body>
</html>
