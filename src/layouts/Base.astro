---
/**
 * The one document shell. Everything the accessibility gate checks at the document level is
 * decided here: lang, a single <main>, the viewport rule, and the theme colours.
 */
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string | undefined;
}
const { title, description } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    {/*
      A2 / ban list: no user-scalable=no AND no maximum-scale below 5. Both block zoom, and the
      second is the one style guides forget.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="color-scheme" content="light dark" />
    {/* A3: one theme-color per media, so the browser chrome follows the system, with no JS. */}
    <meta name="theme-color" content="#FFFCF4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#212320" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* P1: the two faces of the first screen are preloaded; the italic is not shipped at all. */}
    <link
      rel="preload"
      href="/fonts/PublicSans-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GowunBatang-Regular-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
