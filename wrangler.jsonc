{
  // "C'est écrit là" — the Worker of « Demander » (D16.7). Free plan, no payment method.
  // One Worker: Static Assets serve everything; the script only sees /api/*, and of those it
  // answers /api/ask (and /api/bench on the preview host, behind a key).
  //
  // This file is deployed only when data/2026/ask.json says the site answers questions
  // ("answer" or "select") — scripts/deploy.ts picks it, never choose by hand. While the mode is
  // "off" the app is static files only (wrangler.static.jsonc), and so is the holding page,
  // always: the page that stands in for the app depends on nothing the app depends on.
  //
  // What it binds, and nothing else (the list of 09-architecture.md predates D13.1 and D16):
  //   AI      Workers AI, through the AI Gateway "aec" (cache of 30 days, logs off)
  //   DB      the private base: the text of the 2026 edition, read, never served (D16.6)
  //   BUDGET  the daily allowance, one Durable Object for the whole site (D7.4)
  //   RATE    the rate limiter, on a key that says nothing of an address (D7.5)
  // No KV, no Analytics Engine, no cron, no queue. Three secrets are set in the editor's
  // terminal with `wrangler secret put`, never written here: TURNSTILE_SECRET, RATE_SALT, and
  // BENCH_KEY (preview only).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cestecritla",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-09",

  // Custom domains on the Free zone (D10.2). workers.dev stays off so the only public
  // origin is the .fr (CSP, OG URLs, LCEN).
  "routes": [
    { "pattern": "cestecritla.fr", "custom_domain": true },
    { "pattern": "www.cestecritla.fr", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,

  // Astro static output. Everything under ./dist is served by Static Assets: free, unlimited,
  // outside the invocation counter. Only /api/* reaches the script; over the daily request
  // limit /api/* answers 429 while the static site keeps working — and the page then shows
  // what it found by itself.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },

  "ai": { "binding": "AI" },

  // The private base. `database_id` is written here when the editor creates it
  // (`wrangler d1 create cestecritla-ask`): until then the zeros below refuse to deploy, which
  // is the point — scripts/build-mode.test.ts reads this line.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cestecritla-ask",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "NeuronBudget" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NeuronBudget"] }],

  // Six questions a minute for one visitor: more than anyone reads, less than a script wants.
  "ratelimits": [
    { "name": "RATE", "namespace_id": "2026", "simple": { "limit": 6, "period": 60 } },
  ],

  "vars": {
    // The state of the book the site was built from. A page or a base at another version gets
    // the "local" answer (scripts/build-mode.test.ts holds this to the manifest).
    "CORPUS_VERSION": "27ee6e713fe25e7e",
    "ENVIRONMENT": "production",
    "TURNSTILE_HOSTNAMES": "cestecritla.fr,www.cestecritla.fr",
    // Neurons a day the site allows itself, of the 10 000 the free plan gives (D7.4).
    "NEURON_HARD_STOP": "8500",
  },

  // No logs at all (D0.22, D7.8, ADR-10): no invocation logs, no traces. A question about a
  // political programme is sensitive data; the one way not to leak it is not to write it.
  "observability": { "enabled": false },

  "minify": true,
  "upload_source_maps": false,
  "keep_vars": false,

  // The preview host (D15.12): where the app is built, benched and tried on real phones while
  // the apex keeps serving the holding page (D15.4). Deployed as the Worker
  // "cestecritla-preview" by `npm run deploy:preview`; `noindex` comes from public/_headers.
  //
  // `routes` is an INHERITABLE key: without the block below this environment would inherit the
  // apex and take it over on its first deploy (scripts/build-mode.test.ts holds that line).
  // Bindings and `vars` are NOT inherited, so they are repeated. The base is the same one —
  // one copy of the text at Cloudflare, not two; the counter is this Worker's own.
  "env": {
    "preview": {
      "routes": [{ "pattern": "beta.cestecritla.fr", "custom_domain": true }],
      // Inherited from the top in wrangler's own rules — and written again here, so that the
      // gate reads it where it applies: the bench runs on this Worker, with real questions.
      "observability": { "enabled": false },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cestecritla-ask",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "BUDGET", "class_name": "NeuronBudget" }],
      },
      "ratelimits": [
        { "name": "RATE", "namespace_id": "2027", "simple": { "limit": 6, "period": 60 } },
      ],
      "vars": {
        "CORPUS_VERSION": "27ee6e713fe25e7e",
        "ENVIRONMENT": "preview",
        "TURNSTILE_HOSTNAMES": "beta.cestecritla.fr",
        "NEURON_HARD_STOP": "8500",
      },
    },
  },
}
