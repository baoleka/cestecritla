{
  // "C'est écrit là" — the Worker of the preview host (D16.7). Free plan, no payment method.
  // One Worker: Static Assets serve everything; the script only sees /api/*, and of those it
  // answers /api/gists and /api/chat (closed while data/2026/ask.json says "off") and
  // /api/bench, behind a key.
  //
  // scripts/deploy.ts picks this file, never choose by hand — and only for the preview host:
  // when its pages ask, and for the bench (`-- --bench`). The apex is never deployed with it
  // (PLAN-CHAT lot C10): the site there is static files (wrangler.static.jsonc), like the
  // holding page, and its chat is a Worker of its own on two exact addresses
  // (wrangler.chat.jsonc). The top level below stays what CI bundles and what env.preview is
  // read against.
  //
  // THIS IS THE FILE A BARE WRANGLER COMMAND READS — so nothing in its top level names
  // production (14-risques.md R41, 14/11/2026):
  //   - it must EXIST: with no default configuration, wrangler 4 « auto-configures » the
  //     project and deploys a Worker named after package.json — `cestecritla`, production;
  //   - its top-level `name` is a Worker that does not exist, and it has no route: a bare
  //     `wrangler delete`, `rollback` or `secret put` finds nothing, and `--env` with a
  //     mistyped name inherits no address (an unknown environment is read as the top level);
  //   - its `build` step refuses any deploy that scripts/deploy.ts did not start.
  //
  // What it binds, and nothing else (the list of 09-architecture.md predates D13.1 and D16):
  //   AI      Workers AI — through the AI Gateway "aec" for the bench (cache of 30 days, logs
  //           off), and directly for the chat: no gateway, no cache (D16.51)
  //   DB      the private base: the text of the 2026 edition, read by identifier, never
  //           served and never searched (D16.6, D16.22)
  //   BUDGET  the daily allowance, one Durable Object for the whole site (D7.4)
  //   RATE    the rate limiter, on a key that says nothing of an address (D7.5)
  // No KV, no Analytics Engine, no cron, no queue — and no bot check: there is no Turnstile
  // (D16.23). Two secrets are set in the editor's terminal with `wrangler secret put`, never
  // written here: RATE_SALT, and BENCH_KEY (preview only).
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Not a Worker of the account, on purpose (see above): the one this file deploys is named
  // in env.preview.
  "name": "cestecritla-not-deployed",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-09",

  // Runs before wrangler bundles or sends anything, and builds nothing: it stops a deploy
  // that scripts/deploy.ts did not start. Inherited by env.preview.
  "build": { "command": "node scripts/deploy-guard.mjs" },

  // No route at the top level, and workers.dev off: nothing here can be reached, and nothing
  // is inherited by an environment that forgets its own. The only public origin is the .fr
  // (CSP, OG URLs, LCEN) — the preview host's, below.
  "workers_dev": false,
  "preview_urls": false,

  // Astro static output. Everything under ./dist is served by Static Assets: free, unlimited,
  // outside the invocation counter. Only /api/* reaches the script; over the daily request
  // limit /api/* answers 429 while the static site keeps working — and the page then shows
  // what it found by itself.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },

  "ai": { "binding": "AI" },

  // The private base, created with the editor's accord on 2026-11-13T23:01Z
  // (`wrangler d1 create cestecritla-ask --jurisdiction eu`): its data is stored and read in
  // the European Union only. Empty until the text is deposited, which is asked for separately
  // (scripts/seed-ask-2026.ts --remote). An identifier of zeros here refuses to deploy —
  // scripts/build-mode.test.ts reads this line; the same base serves both environments.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cestecritla-ask",
      "database_id": "e6ac3803-eeba-40a5-ae3b-0d8203b4c6c4",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "NeuronBudget" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NeuronBudget"] }],

  // Six sendings a minute for one visitor, on each route apart (src/worker/guards.ts, `RateLane`):
  // more than anyone reads, less than a script wants.
  "ratelimits": [
    { "name": "RATE", "namespace_id": "2026", "simple": { "limit": 6, "period": 60 } },
  ],

  "vars": {
    // The state of the book the site was built from. A page or a base at another version gets
    // the "local" answer (scripts/build-mode.test.ts holds this to the manifest).
    "CORPUS_VERSION": "27ee6e713fe25e7e",
    "ENVIRONMENT": "production",
    // Neurons the site allows itself over any twenty-four hours, of the 10 000 the free plan
    // gives (D7.4) — hours that roll, not a UTC day: src/worker/budget-core.ts.
    "NEURON_HARD_STOP": "8500",
  },

  // No logs at all (D0.22, D7.8, ADR-10): no invocation logs, no traces. A question about a
  // political programme is sensitive data; the one way not to leak it is not to write it.
  "observability": { "enabled": false },

  "minify": true,
  "upload_source_maps": false,
  "keep_vars": false,

  // The preview host (D15.12): where the app is built, benched and tried on real phones while
  // the apex keeps serving the holding page (D15.4). Deployed as the Worker
  // "cestecritla-preview" by `npm run deploy:preview`; `noindex` comes from public/_headers.
  //
  // `routes` is an INHERITABLE key, and so is `name` (as `<top level>-preview`): both are
  // written here, so that this environment is the Worker "cestecritla-preview" on its one
  // host whatever the top level says (scripts/build-mode.test.ts holds both lines).
  // Bindings and `vars` are NOT inherited, so they are repeated. The base is the same one —
  // one copy of the text at Cloudflare, not two; the counter is this Worker's own.
  "env": {
    "preview": {
      "name": "cestecritla-preview",
      "routes": [{ "pattern": "beta.cestecritla.fr", "custom_domain": true }],
      // Inherited from the top in wrangler's own rules — and written again here, so that the
      // gate reads it where it applies: the bench runs on this Worker, with real questions.
      "observability": { "enabled": false },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cestecritla-ask",
          "database_id": "e6ac3803-eeba-40a5-ae3b-0d8203b4c6c4",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "BUDGET", "class_name": "NeuronBudget" }],
      },
      "ratelimits": [
        { "name": "RATE", "namespace_id": "2027", "simple": { "limit": 6, "period": 60 } },
      ],
      "vars": {
        "CORPUS_VERSION": "27ee6e713fe25e7e",
        "ENVIRONMENT": "preview",
        "NEURON_HARD_STOP": "8500",
      },
    },
  },
}
