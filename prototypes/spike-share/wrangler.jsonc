{
  // T4 spike (PLAN-SESSION.md): throwaway Worker rendering share cards as PNG.
  // Free plan only: a Worker with Static Assets on workers.dev, no other binding.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aec-spike-share",
  "main": "src/index.ts",
  // Custom domain (D10.2): DNS records are created by Cloudflare; workers.dev stays enabled for the old links.
  "routes": [
    { "pattern": "cestecritla.fr", "custom_domain": true },
    { "pattern": "www.cestecritla.fr", "custom_domain": true }
  ],
  "workers_dev": true,
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Card PNGs and share pages are rendered by the Worker; everything else
    // (index, /diag, fonts, data) is served by Static Assets.
    "run_worker_first": ["/og/*", "/m/*", "/a/*", "/r/*", "/p/*", "/res/*", "/api/*"]
  },
  "minify": true,
  // Spike only: invocation logs (URL, client metadata) are wanted here to see which preview
  // crawlers fetch what. The app itself must set "logs": { "invocation_logs": false } (D0.22).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Keep the bundle to code + wasm: fonts and data live in ./public and are
  // fetched through the ASSETS binding at runtime (once per isolate).
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
