{
  "name": "aec-spike-share",
  "version": "0.0.1",
  "private": true,
  "description": "T4 spike: throwaway Worker rendering AEC share cards (satori + resvg-wasm) with Open Graph pages",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build-data": "cd ../.. && npx tsx prototypes/spike-share/scripts/build-data.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "satori": "0.32.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.1"
  }
}
