{
  // T7 lab, variant 1b (React prerendered at build time + hydration): assets-only Worker, Free plan.
  // Deploy: npx wrangler deploy -c wrangler.ssg.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aec-lab-fw-react-ssg",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-ssg",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
