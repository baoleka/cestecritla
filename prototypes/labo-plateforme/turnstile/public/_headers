# Static-asset headers (Workers Static Assets). Not applied to Worker responses (/verify, /nonce), which set their own.
# CSP: minimum from the Turnstile reference (script-src + frame-src challenges.cloudflare.com), everything else 'none'/'self'.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
